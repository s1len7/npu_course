# Event Engine 설정. engine.env로 복사해서 채운다. engine.env는 저장소에 올리지 않는다.

# MQTT broker (NAS의 Mosquitto, Tailscale 이름)
ENGINE_MQTT_HOST=silent-nas-ts
ENGINE_MQTT_PORT=1883
# Event Engine 전용 MQTT 계정 (NAS에서 생성)
ENGINE_MQTT_USER=
ENGINE_MQTT_PASSWORD=

# 토픽 (기본값과 같으면 생략 가능)
FRIGATE_TOPIC_PREFIX=frigate
# HA MQTT Statestream의 base_topic
HA_STATESTREAM_TOPIC=homeassistant/statestream
ENGINE_TOPIC_PREFIX=parcel_engine
