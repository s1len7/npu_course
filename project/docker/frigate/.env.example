# .env로 복사해서 값을 채운다. .env는 저장소에 올리지 않는다.
# Frigate는 FRIGATE_ 로 시작하는 환경변수를 config.yml에서 {FRIGATE_이름} 형태로 치환한다.

# 녹화·스냅샷 저장 위치 (저장장치 결정 전까지 기본값 ./storage)
FRIGATE_MEDIA_DIR=./storage

# MQTT broker 접속 정보 (broker 위치·인증 방식 미확인)
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=

# HailoRT service 버전(NPU 공유, Hailo Whisper STT와 함께 사용)을 쓸 때만 주석 해제 (compose.service.yaml)
# COMPOSE_FILE=compose.yaml:compose.service.yaml
